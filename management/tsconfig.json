/** 管理页面 TypeScript 配置；定义 Vue 和 Vite 的严格类型检查及浏览器运行环境。 */
{
  "compilerOptions": {"target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM"], "types": ["vite/client", "node"], "noEmit": true},
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
