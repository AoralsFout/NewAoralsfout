# 展示站运行配置：沿用 NeoBlog 的数据库和 JWT；关键配置由 config/env.ts 读取。
DATABASE_URL=mysql://user:password@127.0.0.1:3306/neoblog
JWT_SECRET=
NODE_ENV=development
PORT=3002
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:3002
OAUTH_CALLBACK_URL=http://localhost:5174/api/auth/natayark/callback
CLIENT_ID=
CLIENT_SECRET=
NATAYARK_AUTHORIZATION_URL=https://account.naids.com/oauth2/authorize
NATAYARK_TOKEN_URL=https://account.naids.com/api/oauth2/token
NATAYARK_USERINFO_URL=https://account.naids.com/api/api/user/data
COOKIE_DOMAIN=
STEAM_API_KEY=
STEAM_ID=
BANGUMI_USERNAME=
GITHUB_USERNAME=
# 全部仓库语言统计要求 Token 属于上述账号并覆盖所有仓库；classic PAT 需 repo 和 read:user。
# fine-grained PAT 需全部仓库的 Metadata 读取权限，且 /user 需提供 owned_private_repos 计数。
GITHUB_TOKEN=
NEOBLOG_FRONTEND_URL=
NEOBLOG_ASSET_URL=
SYNC_ENABLED=true
